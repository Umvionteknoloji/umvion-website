# Umvion Teknoloji - Hostinger (Apache/LiteSpeed) ayarları
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# HTTPS ve www'ye yönlendir
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# Sondaki eğik çizgiyi kaldır: /hizmetler/ -> /hizmetler
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Eski (builder) adresleri aynen çalışsın: /hizmetler -> hizmetler.html
# Not: .html'li adresler de çalışır; sayfalardaki canonical etiketi Google için temiz adresi gösterir.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

# Önbellek ve sıkıştırma
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
